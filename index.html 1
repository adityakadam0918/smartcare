<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SmartCare - Enterprise Healthcare Platform</title>
<script src="https://cdn.tailwindcss.com"></script>
<script>
tailwind.config = {
  darkMode: 'class',
  theme: { extend: { colors: {
    brand: {50:'#eef2ff',100:'#e0e7ff',500:'#6366f1',600:'#4f46e5',700:'#4338ca'}
  }}}
};
</script>
<script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
<script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
<script src="https://unpkg.com/lucide@latest"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="h-full text-slate-800 antialiased selection:bg-brand-500 selection:text-white">
<div id="root" class="min-h-full flex flex-col"></div>

<script type="text/babel">
const {useState,useEffect,useRef}=React;

const USERS_TABLE=[
 {email:"patient1@smartcare.com",password:"password123",role:"Patient"},
 {email:"patient2@smartcare.com",password:"password123",role:"Patient"}
];
const DOCTOR_TABLE=[
 {id:"DOC101",email:"doc1@smartcare.com",password:"password123",name:"Dr. Rajesh Deshmukh",specialty:"Cardiology",location:"Mumbai, MH",fee:1500,rating:4.9,reviewCount:128,experience:12,bio:"Specialist in preventative cardiology and arrhythmia management."},
 {id:"DOC102",email:"doc2@smartcare.com",password:"password123",name:"Dr. Ananya Kulkarni",specialty:"Dermatology",location:"Pune, MH",fee:1200,rating:4.8,reviewCount:94,experience:8,bio:"Focused on surgical dermatology, eczema, and skin conditions."},
 {id:"DOC103",email:"doc3@smartcare.com",password:"password123",name:"Dr. Vikram Jadhav",specialty:"Neurology",location:"Kolhapur, MH",fee:1800,rating:4.9,reviewCount:210,experience:15,bio:"Expert in migraine treatment and neuro-rehabilitation."}
];
const ADMIN_TABLE=[{id:"ADM001",email:"admin@smartcare.com",password:"password123"}];
const INITIAL_APPOINTMENTS=[
 {id:101,patientName:"Aarav Sharma",doctorId:"DOC101",doctorName:"Dr. Rajesh Deshmukh",specialty:"Cardiology",date:"2026-08-15",time:"10:00 AM",status:"approved",symptoms:"Mild chest tightness after exercise",paid:true,prescription:"Aspirin 81mg daily, Routine ECG recommended."},
 {id:102,patientName:"Aarav Sharma",doctorId:"DOC102",doctorName:"Dr. Ananya Kulkarni",specialty:"Dermatology",date:"2026-08-02",time:"02:30 PM",status:"completed",symptoms:"Persistent skin rash on forearms",paid:true,prescription:"Hydrocortisone cream 1% twice daily for 7 days.",rated:false}
];
const SPECIALTY_RULES={
 Cardiology:["chest pain","palpitations","shortness of breath","high blood pressure","dizziness","chest tightness"],
 Dermatology:["rash","skin itch","acne","mole changes","eczema","red spots","itching"],
 Neurology:["migraine","severe headache","numbness","seizure","memory loss","dizziness"],
 Orthopedics:["joint pain","bone fracture","back pain","knee swelling","sprain","bone"],
 "General Medicine":["fever","cough","fatigue","sore throat","cold","flu"]
};

function Icon({name,className="w-4 h-4"}) {
  return <i data-lucide={name} className={className}></i>;
}

function App(){
 const [isAuthenticated,setIsAuthenticated]=useState(false);
 const [role,setRole]=useState("Patient"),[userEmail,setUserEmail]=useState(""),[userId,setUserId]=useState("");
 const [loginRoleSelect,setLoginRoleSelect]=useState("Patient"),[loginEmailInput,setLoginEmailInput]=useState(""),[loginPasswordInput,setLoginPasswordInput]=useState(""),[roleSpecificIdInput,setRoleSpecificIdInput]=useState(""),[loginError,setLoginError]=useState(false),[toastMessage,setToastMessage]=useState("");
 const [activeTab,setActiveTab]=useState("search"),[doctors,setDoctors]=useState(DOCTOR_TABLE),[appointments,setAppointments]=useState(INITIAL_APPOINTMENTS);
 const [selectedSpecialty,setSelectedSpecialty]=useState("All"),[searchQuery,setSearchQuery]=useState("");
 const [isSymptomModalOpen,setIsSymptomModalOpen]=useState(false),[bookingDoctor,setBookingDoctor]=useState(null),[ratingAppointment,setRatingAppointment]=useState(null);
 const [symptomInput,setSymptomInput]=useState(""),[aiAnalysis,setAiAnalysis]=useState(null);
 const [bookingDate,setBookingDate]=useState("2026-08-16"),[bookingTime,setBookingTime]=useState("10:00 AM"),[bookingSymptoms,setBookingSymptoms]=useState(""),[isPayingOnline,setIsPayingOnline]=useState(true),[isPaymentProcessing,setIsPaymentProcessing]=useState(false);
 const [userRating,setUserRating]=useState(5),[userReview,setUserReview]=useState("");
 const appointmentChartRef=useRef(null),specialtyChartRef=useRef(null),chartInstances=useRef({});

 useEffect(()=>{if(window.lucide) window.lucide.createIcons();});
 const triggerToast=msg=>{setToastMessage(msg);setTimeout(()=>setToastMessage(""),3000);};

 useEffect(()=>{
   if(isAuthenticated&&role==="Admin"&&activeTab==="dashboard"){
     Object.values(chartInstances.current).forEach(c=>c?.destroy());
     if(appointmentChartRef.current) chartInstances.current.appChart=new Chart(appointmentChartRef.current,{
       type:"bar",data:{labels:["Mon","Tue","Wed","Thu","Fri","Sat","Sun"],datasets:[{label:"Appointments",data:[12,19,15,22,18,8,5],backgroundColor:"#6366f1",borderRadius:8}]},
       options:{responsive:true,maintainAspectRatio:false}
     });
     if(specialtyChartRef.current) chartInstances.current.specChart=new Chart(specialtyChartRef.current,{
       type:"doughnut",data:{labels:["Cardiology","Dermatology","Neurology","Orthopedics","General Medicine"],datasets:[{data:[30,25,15,10,20],backgroundColor:["#4f46e5","#ec4899","#8b5cf6","#f59e0b","#10b981"]}]},
       options:{responsive:true,maintainAspectRatio:false}
     });
   }
 },[isAuthenticated,role,activeTab]);

 const handleAuthLogin=e=>{
   e.preventDefault();setLoginError(false);
   const email=loginEmailInput.trim(),password=loginPasswordInput.trim(),idVal=roleSpecificIdInput.trim();
   if(loginRoleSelect==="Patient"){
     const valid=USERS_TABLE.find(u=>u.email===email&&u.password===password)||(email&&password);
     if(valid){setRole("Patient");setUserEmail(email);setIsAuthenticated(true);setActiveTab("search");triggerToast("Welcome Patient!");}else setLoginError(true);
   }else if(loginRoleSelect==="Doctor"){
     const d=DOCTOR_TABLE.find(x=>x.id===idVal&&x.email===email&&x.password===password);
     if(d){setRole("Doctor");setUserEmail(email);setUserId(d.id);setIsAuthenticated(true);setActiveTab("dashboard");triggerToast(`Logged in successfully as ${d.id}`);}else setLoginError(true);
   }else{
     const a=ADMIN_TABLE.find(x=>x.id===idVal&&x.email===email&&x.password===password);
     if(a){setRole("Admin");setUserEmail(email);setUserId(a.id);setIsAuthenticated(true);setActiveTab("dashboard");triggerToast("Administrator Access Granted");}else setLoginError(true);
   }
 };
 const handleLogout=()=>{setIsAuthenticated(false);setLoginEmailInput("");setLoginPasswordInput("");setRoleSpecificIdInput("");setLoginError(false);triggerToast("Logged out successfully");};

 const handleSymptomAnalysis=()=>{
   if(!symptomInput.trim()) return;
   const text=symptomInput.toLowerCase();let best="General Medicine",max=0;
   Object.entries(SPECIALTY_RULES).forEach(([spec,words])=>{const count=words.filter(w=>text.includes(w)).length;if(count>max){max=count;best=spec;}});
   const confidence=max===0?.60:Math.min(.70+max*.10,.98);
   setAiAnalysis({specialty:best,confidence:Math.round(confidence*100)});
 };
 const filteredDoctors=doctors.filter(d=>(selectedSpecialty==="All"||d.specialty===selectedSpecialty)&&[d.name,d.specialty,d.location].some(v=>v.toLowerCase().includes(searchQuery.toLowerCase())));
 const finalizeBooking=paid=>{
   const a={id:Date.now(),patientName:userEmail.split("@")[0],doctorId:bookingDoctor.id,doctorName:bookingDoctor.name,specialty:bookingDoctor.specialty,date:bookingDate,time:bookingTime,status:"approved",symptoms:bookingSymptoms,paid,prescription:null};
   setAppointments(prev=>[a,...prev]);setBookingDoctor(null);setBookingSymptoms("");setActiveTab("dashboard");triggerToast("Appointment booked successfully!");
 };
 const handleCreateBooking=e=>{e.preventDefault();if(isPayingOnline){setIsPaymentProcessing(true);setTimeout(()=>{finalizeBooking(true);setIsPaymentProcessing(false)},1200)}else finalizeBooking(false)};
 const handleStatusChange=(id,status)=>setAppointments(prev=>prev.map(a=>a.id===id?{...a,status}:a));
 const handleReviewSubmit=e=>{
   e.preventDefault();setDoctors(prev=>prev.map(d=>{if(d.id!==ratingAppointment.doctorId)return d;const n=d.reviewCount+1;return {...d,rating:Number(((d.rating*d.reviewCount+userRating)/n).toFixed(1)),reviewCount:n}}));
   setAppointments(prev=>prev.map(a=>a.id===ratingAppointment.id?{...a,rated:true}:a));setRatingAppointment(null);setUserReview("");triggerToast("Review submitted successfully!");
 };

 if(!isAuthenticated) return <div className="flex-1 flex items-center justify-center p-4 bg-slate-100">
   <div className="max-w-md w-full bg-white rounded-3xl shadow-xl border border-slate-200 p-8 space-y-6">
    <div className="text-center space-y-2"><div className="inline-flex bg-brand-600 text-white p-3 rounded-2xl shadow-md"><Icon name="activity" className="w-8 h-8"/></div><h1 className="text-2xl font-extrabold text-slate-900">SmartCare Portal Login</h1><p className="text-xs text-slate-500">Select your role and enter verified credentials</p></div>
    {loginError&&<div className="bg-red-50 border border-red-200 text-red-700 text-xs p-3 rounded-xl text-center font-semibold">Invalid ID or Password</div>}
    <form onSubmit={handleAuthLogin} className="space-y-4">
      <div><label className="block text-xs font-semibold text-slate-700 mb-1">Select Role</label><select value={loginRoleSelect} onChange={e=>setLoginRoleSelect(e.target.value)} className="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm"><option>Patient</option><option>Doctor</option><option>Admin</option></select></div>
      <div><label className="block text-xs font-semibold text-slate-700 mb-1">Email Address</label><input type="email" required placeholder="name@example.com" value={loginEmailInput} onChange={e=>setLoginEmailInput(e.target.value)} className="w-full px-3 py-2.5 border border-slate-200 rounded-xl text-sm"/></div>
      <div><label className="block text-xs font-semibold text-slate-700 mb-1">Password</label><input type="password" required placeholder="••••••••" value={loginPasswordInput} onChange={e=>setLoginPasswordInput(e.target.value)} className="w-full px-3 py-2.5 border border-slate-200 rounded-xl text-sm"/></div>
      {loginRoleSelect!=="Patient"&&<div><label className="block text-xs font-semibold text-slate-700 mb-1">{loginRoleSelect==="Doctor"?"Doctor ID":"Admin ID"}</label><input required placeholder={loginRoleSelect==="Doctor"?"DOC101":"ADM001"} value={roleSpecificIdInput} onChange={e=>setRoleSpecificIdInput(e.target.value)} className="w-full px-3 py-2.5 border border-slate-200 rounded-xl text-sm font-mono"/></div>}
      <button className="w-full bg-brand-600 hover:bg-brand-700 text-white font-semibold py-3 rounded-xl text-sm shadow-md">Access Dashboard</button>
    </form>
    <div className="bg-slate-50 p-4 rounded-xl text-xs text-slate-500 space-y-1 border border-slate-200"><span className="font-bold text-slate-700 block mb-1">Demo Credentials:</span><div>• <b>Patient:</b> Any email + password123</div><div>• <b>Doctor:</b> DOC101 | doc1@smartcare.com | password123</div><div>• <b>Admin:</b> ADM001 | admin@smartcare.com | password123</div></div>
   </div>
 </div>;

 return <div className="flex-1 flex flex-col">
  <header className="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm"><div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
   <div className="flex items-center gap-3"><div className="bg-brand-600 text-white p-2 rounded-xl"><Icon name="activity" className="w-6 h-6"/></div><div><span className="text-xl font-bold text-slate-900">SmartCare</span><span className="hidden sm:inline-block ml-2 text-xs bg-brand-50 text-brand-700 px-2 py-0.5 rounded-full font-semibold">Role: {role} {userId?`(${userId})`:""}</span></div></div>
   <nav className="hidden md:flex gap-1">
    {role==="Patient"&&<><button onClick={()=>setActiveTab("search")} className={`px-4 py-2 rounded-lg font-medium text-sm ${activeTab==="search"?"bg-slate-100":"text-slate-600"}`}>Find Doctors</button><button onClick={()=>setIsSymptomModalOpen(true)} className="px-4 py-2 rounded-lg font-medium text-sm text-brand-600 hover:bg-brand-50 flex items-center gap-1.5"><Icon name="sparkles"/>AI Symptom Checker</button></>}
    <button onClick={()=>setActiveTab("dashboard")} className={`px-4 py-2 rounded-lg font-medium text-sm ${activeTab==="dashboard"?"bg-slate-100":"text-slate-600"}`}>Dashboard</button>
    {role==="Patient"&&<button onClick={()=>setActiveTab("history")} className={`px-4 py-2 rounded-lg font-medium text-sm ${activeTab==="history"?"bg-slate-100":"text-slate-600"}`}>Medical Records</button>}
   </nav>
   <div className="flex items-center gap-3"><span className="text-xs text-slate-600 font-medium hidden sm:inline">{userEmail}</span><button onClick={handleLogout} className="text-xs bg-red-50 text-red-700 hover:bg-red-100 font-semibold px-3 py-1.5 rounded-lg">Sign Out</button></div>
  </div></header>

  <main className="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
   {role==="Patient"&&activeTab==="search"&&<section className="space-y-6">
    <div className="bg-gradient-to-r from-brand-600 to-indigo-800 rounded-3xl p-8 text-white shadow-xl"><h1 className="text-3xl sm:text-4xl font-extrabold">Find the right care, right when you need it.</h1><p className="text-brand-100 text-sm sm:text-base mt-4">Search certified specialists across Mumbai, Pune, and Kolhapur, book consultations instantly, and track electronic health records.</p><button onClick={()=>setIsSymptomModalOpen(true)} className="mt-5 bg-white text-brand-700 font-semibold px-5 py-2.5 rounded-xl flex items-center gap-2 text-sm"><Icon name="bot"/>Analyze Symptoms with AI</button></div>
    <div className="flex flex-col sm:flex-row gap-4 justify-between items-center bg-white p-4 rounded-2xl border border-slate-200 shadow-sm"><div className="w-full sm:w-auto flex-1 max-w-md relative"><input placeholder="Search doctor name or city..." value={searchQuery} onChange={e=>setSearchQuery(e.target.value)} className="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-xl text-sm"/><Icon name="search" className="w-4 h-4 absolute left-3 top-2.5 text-slate-400"/></div><div className="w-full sm:w-auto flex items-center gap-2 overflow-x-auto pb-1"><span className="text-xs font-semibold text-slate-500">Specialty:</span>{["All",...Object.keys(SPECIALTY_RULES)].map(s=><button key={s} onClick={()=>setSelectedSpecialty(s)} className={`text-xs px-3 py-1.5 rounded-lg font-medium whitespace-nowrap ${selectedSpecialty===s?"bg-brand-600 text-white":"bg-slate-100 text-slate-600"}`}>{s}</button>)}</div></div>
    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">{filteredDoctors.map(doc=><div key={doc.id} className="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col justify-between hover:shadow-lg"><div><div className="flex justify-between items-start mb-3"><div><h3 className="font-bold text-slate-900 text-lg">{doc.name}</h3><span className="inline-block text-xs font-semibold text-brand-600 bg-brand-50 px-2.5 py-0.5 rounded-full mt-1">{doc.specialty}</span></div><div className="text-amber-600 font-bold text-xs bg-amber-50 px-2 py-1 rounded-lg">★ {doc.rating} ({doc.reviewCount})</div></div><p className="text-xs text-slate-500 mb-4">{doc.bio}</p><div className="space-y-1.5 text-xs text-slate-600 mb-6"><div className="flex items-center gap-2"><Icon name="map-pin" className="w-3.5 h-3.5 text-slate-400"/>{doc.location}</div><div className="flex items-center gap-2"><Icon name="award" className="w-3.5 h-3.5 text-slate-400"/>{doc.experience} Years Experience</div><div className="flex items-center gap-2"><Icon name="indian-rupee" className="w-3.5 h-3.5 text-slate-400"/>₹{doc.fee} Consultation Fee</div></div></div><button onClick={()=>setBookingDoctor(doc)} className="w-full bg-slate-900 hover:bg-slate-800 text-white font-medium py-2.5 rounded-xl text-sm">Book Consultation</button></div>)}</div>
   </section>}

   {role==="Patient"&&activeTab==="history"&&<section className="space-y-6"><div><h2 className="text-2xl font-bold text-slate-900">Your Medical Records</h2><p className="text-slate-500 text-sm">Past consultations, doctor notes, and active prescriptions.</p></div>{appointments.map(app=><div key={app.id} className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-3"><div className="flex justify-between border-b pb-3"><div><h3 className="font-bold">{app.doctorName}</h3><p className="text-xs text-slate-500">{app.specialty} • Consultation on {app.date}</p></div><span className="text-xs bg-blue-50 text-blue-700 px-3 py-1 rounded-full font-bold uppercase">{app.status}</span></div><div className="bg-slate-50 p-4 rounded-xl border text-xs"><b>Prescription & Treatment Notes:</b><p className="text-slate-600 italic mt-1">{app.prescription||"No active prescription notes attached yet."}</p></div>{app.status==="completed"&&!app.rated&&<div className="flex justify-end"><button onClick={()=>setRatingAppointment(app)} className="text-xs bg-amber-50 text-amber-700 border border-amber-200 font-semibold px-3 py-1.5 rounded-lg">★ Leave Feedback & Rating</button></div>}</div>)}</section>}

   {activeTab==="dashboard"&&<section className="space-y-6"><div><h2 className="text-2xl font-bold text-slate-900">{role} Dashboard</h2><p className="text-slate-500 text-sm">{role==="Patient"?"Manage your upcoming bookings and sessions.":role==="Doctor"?`Viewing active clinical schedule for Doctor ID: ${userId}`:"Enterprise health platform telemetry and analytics."}</p></div>
    {role==="Admin"&&<><div className="grid grid-cols-1 sm:grid-cols-4 gap-4">{[["Total Users","1,248"],["Active Doctors",doctors.length],["Total Appointments",appointments.length],["Gross Revenue","₹14,25,000"]].map(([l,v])=><div className="bg-white p-5 rounded-2xl border shadow-sm" key={l}><span className="text-xs text-slate-500 font-semibold uppercase">{l}</span><p className="text-2xl font-bold mt-1">{v}</p></div>)}</div><div className="grid grid-cols-1 lg:grid-cols-2 gap-6"><div className="bg-white p-6 rounded-2xl border shadow-sm"><h3 className="font-bold mb-4 text-sm">Weekly Patient Volume</h3><div className="h-64"><canvas ref={appointmentChartRef}/></div></div><div className="bg-white p-6 rounded-2xl border shadow-sm"><h3 className="font-bold mb-4 text-sm">Specialty Distribution</h3><div className="h-64"><canvas ref={specialtyChartRef}/></div></div></div></>}
    {role!=="Admin"&&<div className="bg-white rounded-2xl border overflow-hidden shadow-sm"><div className="p-6 border-b font-bold">{role==="Doctor"?`Assigned Queue for Doctor ID: ${userId}`:"Scheduled Consultations"}</div><div className="overflow-x-auto"><table className="w-full text-left text-xs sm:text-sm"><thead className="bg-slate-50 text-slate-500 uppercase"><tr><th className="p-4">{role==="Doctor"?"Patient Name":"Doctor Name"}</th><th className="p-4">Specialty</th><th className="p-4">Date & Time</th><th className="p-4">Status / Actions</th></tr></thead><tbody className="divide-y">{appointments.map(app=><tr key={app.id}><td className="p-4 font-bold">{role==="Doctor"?app.patientName:app.doctorName}</td><td className="p-4">{app.specialty}</td><td className="p-4">{app.date} at {app.time}</td><td className="p-4 flex gap-2 items-center">{role==="Doctor"&&app.status==="pending"&&<><button onClick={()=>handleStatusChange(app.id,"approved")} className="bg-emerald-600 text-white px-3 py-1.5 rounded-lg">Approve</button><button onClick={()=>handleStatusChange(app.id,"cancelled")} className="bg-slate-200 px-3 py-1.5 rounded-lg">Decline</button></>}{role==="Doctor"&&app.status==="approved"&&<button onClick={()=>handleStatusChange(app.id,"completed")} className="bg-blue-600 text-white px-3 py-1.5 rounded-lg">Complete</button>}<span className="bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-full font-bold uppercase">{app.status}</span></td></tr>)}</tbody></table></div></div>}
   </section>}
  </main>

  <footer className="bg-slate-900 text-slate-300 mt-auto"><div className="max-w-7xl mx-auto px-4 py-10 grid md:grid-cols-4 gap-8"><div><div className="flex items-center gap-2 text-white font-bold text-lg"><div className="bg-brand-600 p-2 rounded-xl"><Icon name="activity"/></div>SmartCare</div><p className="text-xs text-slate-400 mt-4">© 2026 SmartCare | All Rights Reserved</p><p className="text-xs text-brand-400 mt-3">Designed by Aditya Kadam</p></div><div><h4 className="text-xs font-bold text-white uppercase">Contact Info</h4><p className="text-xs text-slate-400 mt-3">support@smartcare.com</p><p className="text-xs text-slate-400 mt-2">+91 98765 43210</p><p className="text-xs text-slate-400 mt-2">Pune, Maharashtra, India</p></div><div><h4 className="text-xs font-bold text-white uppercase">Quick Links</h4><div className="text-xs text-slate-400 space-y-2 mt-3"><p>Home</p><p>About</p><p>Services</p><p>FAQ</p><p>Privacy Policy</p></div></div><div><h4 className="text-xs font-bold text-white uppercase">Social Media</h4><div className="text-xs text-slate-400 space-y-2 mt-3"><p>facebook: smartcareofficial</p><p>instagram: smartcareofficial</p><p>linkedin: smartcareofficial</p></div></div></div><div className="border-t border-slate-800 text-center py-5 text-xs text-slate-400">Powered by Inplant Training 2026</div></footer>

  {isSymptomModalOpen&&<div className="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4"><div className="bg-white rounded-3xl max-w-lg w-full p-6 space-y-4 shadow-2xl"><div className="flex justify-between"><h3 className="font-bold text-lg flex gap-2"><Icon name="sparkles"/>AI Symptom Triage Assistant</h3><button onClick={()=>{setIsSymptomModalOpen(false);setAiAnalysis(null)}}><Icon name="x"/></button></div><p className="text-xs text-slate-500">Describe your symptoms to get matched with a medical specialty.</p><textarea rows="3" value={symptomInput} onChange={e=>setSymptomInput(e.target.value)} placeholder="e.g. Sharp chest tightness and shortness of breath..." className="w-full p-3 border rounded-xl text-sm"/><button onClick={handleSymptomAnalysis} className="w-full bg-brand-600 text-white font-semibold py-2.5 rounded-xl">Analyze Symptoms</button>{aiAnalysis&&<div className="bg-brand-50 border p-4 rounded-xl text-xs space-y-2"><b>Recommended Specialty: {aiAnalysis.specialty}</b><div>Confidence Match Score: {aiAnalysis.confidence}%</div><button onClick={()=>{setSelectedSpecialty(aiAnalysis.specialty);setIsSymptomModalOpen(false);setAiAnalysis(null);setActiveTab("search")}} className="w-full bg-brand-600 text-white font-bold py-2 rounded-lg">View Specialists in {aiAnalysis.specialty}</button></div>}</div></div>}

  {bookingDoctor&&<div className="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4"><div className="bg-white rounded-3xl max-w-md w-full p-6 space-y-4 shadow-2xl"><div className="flex justify-between"><h3 className="font-bold text-lg">Book Consultation</h3><button onClick={()=>setBookingDoctor(null)}><Icon name="x"/></button></div><div className="text-xs text-slate-500">Booking with <b>{bookingDoctor.name}</b> ({bookingDoctor.specialty}) • Fee: ₹{bookingDoctor.fee}</div>{isPaymentProcessing?<div className="py-12 text-center"><div className="w-10 h-10 border-4 border-brand-600 border-t-transparent rounded-full animate-spin mx-auto"/><p className="text-sm font-semibold mt-4">Processing UPI / Card Gateway...</p></div>:<form onSubmit={handleCreateBooking} className="space-y-3 text-xs"><div><label className="font-semibold">Consultation Date</label><input type="date" value={bookingDate} onChange={e=>setBookingDate(e.target.value)} required className="w-full mt-1 p-2 border rounded-xl"/></div><div><label className="font-semibold">Time Slot</label><select value={bookingTime} onChange={e=>setBookingTime(e.target.value)} className="w-full mt-1 p-2 border rounded-xl"><option>09:00 AM</option><option>10:00 AM</option><option>02:30 PM</option><option>04:00 PM</option></select></div><div><label className="font-semibold">Describe Symptoms</label><textarea rows="2" value={bookingSymptoms} onChange={e=>setBookingSymptoms(e.target.value)} className="w-full mt-1 p-2 border rounded-xl"/></div><div className="grid grid-cols-2 gap-2"><button type="button" onClick={()=>setIsPayingOnline(true)} className={`p-2 rounded-xl border font-bold ${isPayingOnline?"border-brand-600 bg-brand-50 text-brand-700":""}`}>Pay Online</button><button type="button" onClick={()=>setIsPayingOnline(false)} className={`p-2 rounded-xl border font-bold ${!isPayingOnline?"border-brand-600 bg-brand-50 text-brand-700":""}`}>Pay at Clinic</button></div>{isPayingOnline&&<input required placeholder="Enter UPI ID or Card Number" className="w-full p-2.5 border rounded-xl"/>}<button type="submit" className="w-full bg-slate-900 text-white py-3 rounded-xl">{isPayingOnline?`Pay ₹${bookingDoctor.fee} & Book`:"Confirm Booking"}</button></form>}</div></div>}

  {ratingAppointment&&<div className="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4"><div className="bg-white rounded-3xl max-w-md w-full p-6 space-y-4 shadow-2xl"><div className="flex justify-between"><h3 className="font-bold text-lg">Rate Your Experience</h3><button onClick={()=>setRatingAppointment(null)}><Icon name="x"/></button></div><form onSubmit={handleReviewSubmit} className="space-y-4 text-xs"><p className="text-slate-500">With {ratingAppointment.doctorName}</p><div><label className="font-semibold block">Rating Stars</label><div className="flex gap-2">{[1,2,3,4,5].map(s=><button type="button" key={s} onClick={()=>setUserRating(s)} className={`text-2xl ${userRating>=s?"text-amber-500":"text-slate-300"}`}>★</button>)}</div></div><textarea rows="3" required value={userReview} onChange={e=>setUserReview(e.target.value)} placeholder="Share your experience..." className="w-full p-2 border rounded-xl"/><button className="w-full bg-brand-600 text-white font-semibold py-2.5 rounded-xl">Submit Feedback</button></form></div></div>}

  {toastMessage&&<div className="fixed bottom-6 right-6 bg-slate-900 text-white px-5 py-3 rounded-xl shadow-2xl z-[60] text-xs border-l-4 border-emerald-400">{toastMessage}</div>}
 </div>;
}
ReactDOM.createRoot(document.getElementById("root")).render(<App/>);
</script>
</body>
</html>
